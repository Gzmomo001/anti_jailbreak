# Next.js runtime. Never expose the service-role key to the browser or Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=local_operator_only
SUPABASE_EDGE_FUNCTION_URL=https://PROJECT_REF.supabase.co/functions/v1/process-moderation
MODERATION_WORKER_SECRET=replace_with_a_random_secret
MODERATION_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Edge Function secrets. Configure these with `supabase secrets set`.
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_MODEL=Qwen/Qwen3-8B
